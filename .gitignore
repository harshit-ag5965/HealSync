# ========================
# Root-level .gitignore
# ========================

# Environment variables — NEVER commit these
.env
.env.*
!.env.example

# Dependencies
node_modules/
**/node_modules/

# Build outputs
/frontend/build
/frontend/.pnp
/frontend/.pnp.js

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Coverage
/coverage
**/coverage

